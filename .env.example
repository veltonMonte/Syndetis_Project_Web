# ==========================================
# INFRAESTRUTURA LOCAL (DOCKER)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

# ==========================================
# PORTAS DOS SERVIÇOS LOCAIS
# ==========================================
AUTH_SERVICE_PORT=8081
CORE_SERVICE_PORT=8082
JWT_JWKS_URI=http://localhost:8081/.well-known/jwks.json
# O Compose usa http://auth-service:8081/.well-known/jwks.json internamente.
AUTH_SPRING_PROFILES_ACTIVE=default
ORDER_RESERVATION_TTL_MINUTES=30
INTEGRATION_HUB_PORT=3001
FRONTEND_PORT=5173
GATEWAY_PORT=8080
TRUSTED_PROXY_HOPS=0
TRUSTED_PROXY_CIDRS=
PUBLIC_ORIGIN=http://localhost:8080

# ==========================================
# CONFIGURAÇÕES JWT (RS256) E JWKS
# ==========================================
# O issuer deve ser a URL pública do auth-service; o JWKS interno usa DNS Compose.
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=syndetis
JWT_EXPIRATION=600000
REFRESH_TOKEN_TTL_DAYS=30
# Ative os perfis oauth-google/oauth-github apenas com credenciais configuradas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_OAUTH2_FRONTEND_CALLBACK=http://localhost:8080/auth/callback
JWT_RSA_KEY_ID=auth-key-1
# Fora do Compose, informe o caminho de um PEM PKCS#8 persistente.
# No Compose, a chave é criada uma vez e mantida no volume auth_keys.
JWT_RSA_PRIVATE_KEY_PATH=
# Ou conteúdo PEM Base64 / secret manager (sem quebras de linha ou com \n):
JWT_RSA_PRIVATE_KEY_VALUE=
# Para rotação graciosa de chave pública anterior:
JWT_RSA_PREVIOUS_KEY_ID=auth-key-old
JWT_RSA_PREVIOUS_PUBLIC_KEY_VALUE=

# ==========================================
# CONFIGURAÇÕES DO INTEGRATION-HUB
# ==========================================
SHIPPING_ORIGIN_ZIP=01001000
# Formato: provedor:segredo,outro:segredo
WEBHOOK_SECRETS=

# CPF/CNPJ dos lojistas (Receita Federal). Uma conta de lojista só é criada para um documento ativo.
# CNPJ e MEI: dados abertos da Receita pela BrasilAPI (sem chave).
# CPF: Consulta CPF v3 da SERPRO (CPF + data de nascimento). O ambiente de demonstração gratuito só conhece os
# CPFs de teste da documentação da SERPRO (ex.: 404.428.201-35, nascido em 14/11/1970); use o token de
# demonstração publicado pela SERPRO. Em produção, contrate a API e use
# SERPRO_CPF_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cpf-df/v3 com as chaves do contrato.
SERPRO_CPF_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cpf-df-trial/v3
SERPRO_ACCESS_TOKEN=
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
# Segredo entre auth-service e integration-hub (mínimo 32 caracteres) e chave do HMAC que identifica
# CPF/CNPJ sem guardá-los. Gere valores próprios fora do ambiente local; nunca troque a chave depois.
TAX_ID_INTERNAL_TOKEN=
DOCUMENT_HASH_KEY=

# Mercado Pago e chamadas internas (desabilitado no ambiente local por padrao).
PAYMENTS_ENABLED=false
PAYMENTS_INTERNAL_TOKEN=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Aplicação da Syndetis no Mercado Pago (Suas integrações > Credenciais de produção/teste). Com ela, cada
# lojista conecta a própria conta pelo painel (Recebimentos > Conectar Mercado Pago), sem copiar chaves, e
# recebe direto. Cadastre no Mercado Pago a URL de redirecionamento:
#   <PUBLIC_ORIGIN>/api/core/public/payments/mercadopago/callback   (ex.: http://localhost:8080/api/core/public/...)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Chave que cifra os tokens do Mercado Pago dos lojistas no banco (gere uma própria fora do ambiente local).
PAYMENT_TOKEN_KEY=
MP_SANDBOX=true
# Utilizado somente quando AUTH_SPRING_PROFILES_ACTIVE inclui homologation.
HOMOLOGATION_SELLER_EMAIL=
HOMOLOGATION_SELLER_PASSWORD=

# Asaas: assinaturas por loja, somente Sandbox nesta entrega.
# Cole a chave entre aspas simples para preservar caracteres como $.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=''
# Habilite apos preencher a chave e os dois segredos abaixo.
BILLING_ENABLED=false
# Segredo compartilhado somente entre core e hub (minimo 32 caracteres).
BILLING_INTERNAL_TOKEN=''
# Token distinto da API key, configurado tambem no webhook do Asaas.
ASAAS_WEBHOOK_TOKEN=''

# Limites por IP do gateway: leitura publica /5min, frete /min, webhooks /min.
PUBLIC_READ_RATE_LIMIT=300
# Consultas por código de compra (Meus pedidos), por IP a cada 15 min.
ORDER_LOOKUP_RATE_LIMIT=10
SHIPPING_RATE_LIMIT=20
WEBHOOK_RATE_LIMIT=600
