# ==========================================
# INFRAESTRUTURA LOCAL (DOCKER)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

# ==========================================
# PORTAS DOS SERVIÇOS LOCAIS
# ==========================================
AUTH_SERVICE_PORT=8081
CORE_SERVICE_PORT=8082
JWT_JWKS_URI=http://localhost:8081/.well-known/jwks.json
# O Compose usa http://auth-service:8081/.well-known/jwks.json internamente.
AUTH_SPRING_PROFILES_ACTIVE=default
ORDER_RESERVATION_TTL_MINUTES=30
INTEGRATION_HUB_PORT=3001
FRONTEND_PORT=5173
GATEWAY_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080

# ==========================================
# CONFIGURAÇÕES JWT (RS256) E JWKS
# ==========================================
# O issuer deve ser a URL pública do auth-service; o JWKS interno usa DNS Compose.
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=syndetis
JWT_EXPIRATION=600000
REFRESH_TOKEN_TTL_DAYS=30
# Ative os perfis oauth-google/oauth-github apenas com credenciais configuradas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AUTH_OAUTH2_FRONTEND_CALLBACK=http://localhost:8080/auth/callback
JWT_RSA_KEY_ID=auth-key-1
# Fora do Compose, informe o caminho de um PEM PKCS#8 persistente.
# No Compose, a chave é criada uma vez e mantida no volume auth_keys.
JWT_RSA_PRIVATE_KEY_PATH=
# Ou conteúdo PEM Base64 / secret manager (sem quebras de linha ou com \n):
JWT_RSA_PRIVATE_KEY_VALUE=
# Para rotação graciosa de chave pública anterior:
JWT_RSA_PREVIOUS_KEY_ID=auth-key-old
JWT_RSA_PREVIOUS_PUBLIC_KEY_VALUE=

# ==========================================
# CONFIGURAÇÕES DO INTEGRATION-HUB
# ==========================================
SHIPPING_ORIGIN_ZIP=01001000
# Formato: provedor:segredo,outro:segredo
WEBHOOK_SECRETS=

# Mercado Pago e chamadas internas (desabilitado no ambiente local por padrao).
PAYMENTS_ENABLED=false
PAYMENTS_INTERNAL_TOKEN=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
# Utilizado somente quando AUTH_SPRING_PROFILES_ACTIVE inclui homologation.
HOMOLOGATION_SELLER_EMAIL=
HOMOLOGATION_SELLER_PASSWORD=

# Asaas: assinaturas por loja, somente Sandbox nesta entrega.
# Cole a chave entre aspas simples para preservar caracteres como $.
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=''
# Habilite apos preencher a chave e os dois segredos abaixo.
BILLING_ENABLED=false
# Segredo compartilhado somente entre core e hub (minimo 32 caracteres).
BILLING_INTERNAL_TOKEN=''
# Token distinto da API key, configurado tambem no webhook do Asaas.
ASAAS_WEBHOOK_TOKEN=''
