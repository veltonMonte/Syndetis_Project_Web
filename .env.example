# ==========================================
# INFRAESTRUTURA LOCAL (DOCKER)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
REDIS_PORT=6379

# ==========================================
# PORTAS DOS SERVIÇOS LOCAIS
# ==========================================
AUTH_SERVICE_PORT=8081
CORE_SERVICE_PORT=8082
INTEGRATION_HUB_PORT=3001
FRONTEND_PORT=5173

# ==========================================
# CONFIGURAÇÕES JWT (RS256) E JWKS
# ==========================================
# Em ambiente local: http://localhost:8081
# Em contêiner/Docker Compose: http://auth-service:8081
JWT_ISSUER=http://localhost:8081
JWT_AUDIENCE=syndetis
JWT_EXPIRATION=86400000
JWT_RSA_KEY_ID=auth-key-1
# Caminho para arquivo PEM de chave privada PKCS#8 protegido no servidor:
JWT_RSA_PRIVATE_KEY_PATH=
# Ou conteúdo PEM Base64 / secret manager (sem quebras de linha ou com \n):
JWT_RSA_PRIVATE_KEY_VALUE=
# Para rotação graciosa de chave pública anterior:
JWT_RSA_PREVIOUS_KEY_ID=auth-key-old
JWT_RSA_PREVIOUS_PUBLIC_KEY_VALUE=
