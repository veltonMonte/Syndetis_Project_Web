# Local-only values. Credentials are generated separately; never load the root .env.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_HOST=redis
REDIS_PORT=6379
SPRING_PROFILES_ACTIVE=kubernetes
JWT_ISSUER=http://syndetis-local
JWT_AUDIENCE=syndetis
JWT_RSA_KEY_ID=syndetis-k8s-local-1
JWT_RSA_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_JWKS_URI=http://auth-service:8081/.well-known/jwks.json
GATEWAY_PORT=8080
CORE_SERVICE_PORT=8082
INTEGRATION_HUB_PORT=3001
AUTH_SERVICE_URL=http://auth-service:8081
CORE_SERVICE_URL=http://core-service:8082
INTEGRATION_HUB_URL=http://integration-hub:3001
FRONTEND_URL=http://frontend:8080
PUBLIC_ORIGIN=http://127.0.0.1:8086
CORE_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8086
AUTH_OAUTH2_FRONTEND_CALLBACK=http://127.0.0.1:8086/auth/callback
SERVER_FORWARD_HEADERS_STRATEGY=framework
CORE_EVENTS_ENABLED=true
CORE_EVENTS_STREAM=syndetis:core-events
CORE_EVENTS_GROUP=integration-hub
PAYMENTS_ENABLED=true
PAYMENTS_INTERNAL_TOKEN=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
BILLING_ENABLED=false
BILLING_INTERNAL_TOKEN=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
WEBHOOK_SECRETS=
TRUSTED_PROXY_HOPS=0
PUBLIC_READ_RATE_LIMIT=1000
