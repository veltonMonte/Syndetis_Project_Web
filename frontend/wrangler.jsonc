// Cloudflare Worker that serves the SPA and forwards the API to the AWS edge.
// Deploy: npm run build && npx wrangler deploy
// Secret (once): npx wrangler secret put EDGE_SECRET
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "syndetis-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // API paths must reach the Worker even when a static file could match.
    "run_worker_first": ["/api/*", "/oauth2/*", "/login/oauth2/*", "/.well-known/*"]
  },
  "vars": {
    // Filled after the EC2 is created: https://<ip-with-dashes>.sslip.io until a domain is bought.
    "API_ORIGIN": ""
  },
  "observability": { "enabled": true }
}
