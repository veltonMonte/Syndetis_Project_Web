# Auto detect text files and perform LF normalization
* text=auto

# Source code files - use LF always
*.kt text eol=lf
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf

# Shell scripts must have LF line endings
*.sh text eol=lf
mvnw text eol=lf
gradlew text eol=lf

# Windows batch files must have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
mvnw.cmd text eol=crlf
gradlew.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.jar binary
