# Copie para .env.homologation. Este arquivo contem apenas exemplos.
COMPOSE_PROJECT_NAME=syndetis-homologation
HOMOLOGATION_HOST=syndetis-web.com
PUBLIC_ORIGIN=https://syndetis-web.com
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
AUTH_SPRING_PROFILES_ACTIVE=homologation
HOMOLOGATION_SELLER_EMAIL=lojista@exemplo.com
HOMOLOGATION_SELLER_PASSWORD=
JWT_ISSUER=https://syndetis-web.com
JWT_AUDIENCE=syndetis
AUTH_OAUTH2_FRONTEND_CALLBACK=https://syndetis-web.com/auth/callback
PAYMENTS_ENABLED=true
# Mesmo segredo aleatorio de pelo menos 32 caracteres para core e hub.
PAYMENTS_INTERNAL_TOKEN=
# Credenciais da aplicacao vinculada ao VENDEDOR DE TESTE. Nunca use contas reais aqui.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_SANDBOX=true
